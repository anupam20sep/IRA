{
  "name": "ira-cockpit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "install:local": "bash ./scripts/install.sh",
    "start": "bash ./scripts/dev.sh tauri",
    "start:web": "bash ./scripts/dev.sh web",
    "prod:build": "bash ./scripts/build-production.sh",
    "sync:config": "bash ./scripts/sync-config.sh",
    "verify": "bash ./scripts/verify.sh",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:example": "vitest run src/backend/demo-shop.integration.test.ts",
    "test:url-shortener": "vitest run src/backend/url-shortener.e2e.test.ts",
    "test:staging": "vitest run --config vitest.staging.config.ts",
    "staging:ira": "node --experimental-strip-types src/staging/serve-ira.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "dist": "bash ./scripts/build-production.sh"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.58.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.22.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.7"
  }
}
